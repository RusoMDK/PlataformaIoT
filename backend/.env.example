# ========= Backend ENV (ejemplo) =========
# Copia este archivo a backend/.env y completa valores reales.

# Servidor
PORT=4443
NODE_ENV=development

# Base de datos
MONGO_URI=mongodb://127.0.0.1:27017/granja_iot

# Auth
JWT_SECRET=pon_aqui_una_clave_larga_y_unica

# Integraciones (rellena solo si las usas)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

OPENAI_API_KEY=tu_openai_key

# NOTA: Variables que empiezan con VITE_ pertenecen al FRONTEND (.env del frontend)
# y no deberían estar aquí en el backend.
