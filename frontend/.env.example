# ========= Frontend (Vite) ENV (ejemplo) =========
# Copia a frontend/.env y ajusta a tu entorno local.

# URL del backend (API REST y WS). Usa https:// si tu backend corre con TLS local.
VITE_API_URL=https://localhost:4443
VITE_WS_URL=https://localhost:4443

# URL del agente local (si tu flujo lo usa)
VITE_AGENT_URL=http://localhost:3001
